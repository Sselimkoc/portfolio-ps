generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int     @id @default(autoincrement())
  name        String
  roleLine    String
  bio         String
  email       String
  githubUrl   String
  linkedinUrl String
  cvUrl       String?
  location    String
  school      String
  department  String
  years       String?
  gpa         String?
  language    String   @unique @default("tr") // "en" or "tr"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  group     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  tagline     String
  description String
  tech        String[]
  images      String[] @default([]) // legacy column, kept to avoid data loss
  href        String?
  language    String   @default("tr") // "en" or "tr"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id        Int      @id @default(autoincrement())
  role      String
  company   String
  period    String
  location  String?
  bullets   String[] @default([])
  order     Int      @default(0)
  language  String   @default("tr") // "en" or "tr"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  excerpt     String
  tags        String[] @default([])
  href        String
  publishedAt String?  // e.g. "Ocak 2024"
  language    String   @default("tr") // "en" or "tr"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminAuth {
  id             Int       @id @default(autoincrement())
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
